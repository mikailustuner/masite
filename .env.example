# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
PUBLIC_APP_URL=http://localhost:4173
TRUST_PROXY=false
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://evidera:evidera_dev_password@127.0.0.1:5432/evidera
DATABASE_POOL_MAX=10
# Production compose only: migration owner and restricted runtime role credentials
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=

# Redis / jobs
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=evidera

# Session security — production must use 32+ random bytes
SESSION_COOKIE_NAME=evidera_session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Evidence object storage (S3-compatible)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=evidera-evidence
S3_ACCESS_KEY=evidera
S3_SECRET_KEY=evidera_dev_storage_password
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=none

# Crawler identity and limits
CRAWLER_USER_AGENT=EvideraAuditBot/1.0 (+https://your-domain.example/bot)
CRAWLER_CONTACT_URL=https://your-domain.example/bot
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_DEFAULT_DELAY_MS=1000
CRAWLER_ALLOWED_PORTS=80,443
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
RENDER_TIMEOUT_MS=30000

# Optional external data sources
CRUX_API_BASE_URL=https://chromeuxreport.googleapis.com/v1/records:queryRecord
CRUX_API_KEY=
SERP_PROVIDER=serper
SERP_API_BASE_URL=https://google.serper.dev/
SERP_API_KEY=
SERP_DAILY_QUERY_LIMIT=50
BACKLINK_PROVIDER=disabled
BACKLINK_API_BASE_URL=
BACKLINK_API_KEY=
OPENPAGERANK_API_BASE_URL=https://openpagerank.keywordseverywhere.com/
OPENPAGERANK_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_AD_LIBRARY_ACCESS_TOKEN=

# Production image tags / published ports
EVIDERA_API_IMAGE=evidera-api:latest
EVIDERA_WORKER_IMAGE=evidera-worker:latest
EVIDERA_WEB_IMAGE=evidera-web:latest
WEB_PORT=8080

# Bootstrap is only used by the explicit seed command
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running-seed
BOOTSTRAP_ORGANIZATION_NAME=Evidera Workspace
