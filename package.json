{
  "name": "evidera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led external website intelligence platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @evidera/web",
    "dev:api": "npm run dev --workspace @evidera/api",
    "dev:worker": "npm run dev --workspace @evidera/worker",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace @evidera/database",
    "db:seed": "npm run seed --workspace @evidera/database"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.42.0"
  }
}
